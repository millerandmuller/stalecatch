# Token Factory (OpenAI-compatible). IDs below were read from GET {base}/models (strip the trailing slash first).
TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1/
TOKEN_FACTORY_API_KEY=
NANO_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
ULTRA_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
# Ultra fallback if latency hurts: nvidia/nemotron-3-super-120b-a12b ($0.30/$0.90 per M tokens)
# Reasoning off for the cheap watcher (measured 16 s -> 1.7 s per call); on for Ultra.
NANO_THINKING=0
ULTRA_THINKING=1
SUPER_MODEL=nvidia/nemotron-3-super-120b-a12b
# Tavily re-fetches public donor URLs; local demo pages use plain HTTP.
TAVILY_API_KEY=
PUBLIC_BASE_URL=http://127.0.0.1:8000
JUDGE_MODE=0
